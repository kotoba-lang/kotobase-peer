#!/usr/bin/env kbb
;; bench/ldbc_snb_driver.cljk — an open-loop, scheduled driver for the four
;; LDBC SNB Interactive complex reads served by `kotobase-peer.ldbc-snb-net`,
;; measured the way the benchmark defines its metric and not the way an
;; in-JVM harness does.
;;
;; LDBC SNB Interactive scores ONE number, throughput (ops/s), obtained by
;; running the operation stream at a schedule (the time-compression ratio
;; sets the rate) and accepting the run only if 95% of operations STARTED
;; within 1 second of their scheduled start (spec §"95% on-time
;; requirement", results_log.csv rule `actual_start - scheduled_start <
;; 1 s`). A closed-loop "as fast as N clients can go" number is not that
;; metric; it hides queueing. So this driver:
;;
;;   * schedules operation k at t0 + k/rate, round-robin over the op mix,
;;     each op cycling its OFFICIAL substitution parameters
;;     (substitution_parameters-sf1/interactive_{2,7,8,9}_param.txt);
;;   * dispatches when the schedule says, bounded by --inflight slots (the
;;     analogue of driver threads) -- an op that finds no free slot waits,
;;     and that wait is exactly what the on-time rule measures;
;;   * records scheduled vs actual start, client latency, HTTP status, rows;
;;   * sweeps --rates upward and reports the highest rate whose run had
;;     >= 95% on-time starts and zero failed operations.
;;
;; What it is NOT: the certified LDBC driver. The mix is four complex reads
;; (no short reads, no updates, no dependency tracking), the data is the
;; stated SF1 subset, and there is no auditor. The receipt says so.
;;
;; Every op's row count is recorded and the share of EMPTY answers is
;; printed. An empty answer is fast for the wrong reason (root
;; ADR-2609109900 found the join hazard this way), and a subset can make
;; official parameters empty; the number is there so nobody reads a fast
;; run of empty answers as growth.
;;
;;   kbb --backend sci bench/ldbc_snb_driver.cljk --origin http://127.0.0.1:8090 \
;;     --params ~/.cache/ldbc-snb/sf1/substitution_parameters-sf1 \
;;     --rates 5,10,20,40,80,160 --seconds 20 --inflight 64 [--out file.edn]
;;
;; Exit 0 = receipt written. 2 = REFUSED (server not ready, params missing,
;; or a run had failed operations at the FIRST rate -- nothing was measured).

(ns ldbc-snb-driver
  (:require [clojure.string :as str]
            [clojure.edn :as edn]
            ["fs" :as fs]
            ["os" :as os]
            ["path" :as path]
            ["child_process" :as cp]
            ["perf_hooks" :refer [performance]]))

(defn- host-memory
  "What the host's memory looks like at measurement time. Iteration 14
   (2026-09-11) measured the same IC08 at 1.9 ms in-process and 96-310 ms
   served, on the same data and function, and the difference was the SUT
   JVM paged out on a host with 34 GB of 35 GB swap in use. A load average
   does not show that; swap does. macOS only for the swap line (sysctl);
   elsewhere the keys are nil, not 0."
  []
  (let [total (os/totalmem) free (os/freemem)
        swap (try (str (.execSync cp "sysctl -n vm.swapusage" #js {:encoding "utf8"}))
                  (catch :default _ nil))
        num (fn [k] (when swap (some-> (re-find (re-pattern (str k " = ([0-9.]+)M")) swap) second parse-double)))
        st (num "total") su (num "used")]
    {:total-gib (/ total 1073741824.0) :free-gib (/ free 1073741824.0)
     :swap-total-mib st :swap-used-mib su
     :swap-used-pct (when (and st su (pos? st)) (* 100.0 (/ su st)))}))

(defn- arg [args k default]
  (let [i (.indexOf args k)]
    (if (neg? i) default (nth args (inc i)))))

(defn- now [] (.now performance))

(defn- read-params
  "Complex reads take interactive_<n>_param.txt (personId|maxDate or
   personId). Short reads: IS2 takes the IC07 persons; IS4/IS5/IS7 take
   short_message_param.txt (one message id per line, written from the
   subset by bench/ldbc_short_params.cljk -- LDBC's driver derives short-read
   parameters from complex-read results, and this subset has its own)."
  [dir n]
  (let [f (path/join dir (if (= n :message) "short_message_param.txt" (str "interactive_" n "_param.txt")))
        _ (when-not (fs/existsSync f)
            (println "REFUSED: params missing" f) (js/process.exit 2))
        lines (rest (str/split-lines (fs/readFileSync f "utf8")))]
    (vec (for [l lines :when (seq l)
               :let [[pid md] (str/split l #"\|")]]
           (if (= n :message)
             {:message pid}
             (cond-> {:person pid} md (assoc :max-date (parse-long md))))))))

(defn- read-updates
  "Insert parameters from an LDBC update stream file
   (scheduled|dependency|type|params...): type 2 -> INS2 {:person :post
   :date}, type 8 -> INS8 {:p1 :p2 :date}. Taken in stream order, at most
   `limit` of each. The scheduled times are not used: this driver puts the
   inserts in the round-robin mix at the same rate as the reads (stated in
   the receipt; the certified driver interleaves them by simulation time)."
  [file type limit]
  (when-not (fs/existsSync file) (println "REFUSED: update stream missing" file) (js/process.exit 2))
  (let [t (str type)]
    (->> (str/split-lines (fs/readFileSync file "utf8"))
         (keep (fn [l] (let [[_ _ ty & ps] (str/split l #"\|")]
                         (when (= ty t)
                           (case type
                             1 {:person (nth ps 0) :first (nth ps 1) :last (nth ps 2) :gender (nth ps 3)
                                :birthday (parse-long (nth ps 4)) :date (parse-long (nth ps 5)) :ip (nth ps 6) :browser (nth ps 7) :city (nth ps 8)}
                             2 {:person (nth ps 0) :post (nth ps 1) :date (parse-long (nth ps 2))}
                             3 {:person (nth ps 0) :comment (nth ps 1) :date (parse-long (nth ps 2))}
                             6 {:post (nth ps 0) :date (parse-long (nth ps 2)) :content (nth ps 6) :creator (nth ps 8) :forum (nth ps 9)}
                             7 (let [rp (nth ps 8) rc (nth ps 9)]
                                 {:comment (nth ps 0) :date (parse-long (nth ps 1)) :content (nth ps 4) :creator (nth ps 6)
                                  :parent (if (= rp "-1") rc rp)})
                             4 {:forum (nth ps 0) :title (nth ps 1) :date (parse-long (nth ps 2)) :moderator (nth ps 3)}
                             5 {:person (nth ps 0) :forum (nth ps 1) :date (parse-long (nth ps 2))}
                             8 {:p1 (nth ps 0) :p2 (nth ps 1) :date (parse-long (nth ps 2))})))))
         (take limit) vec)))

(defn- read-stream
  "Every event of an LDBC update stream file as {:sim :dep :type :params},
   in file order (the files are sorted by scheduled time). All eight types
   are sent since iteration 33; an unknown type keeps :params nil and still
   advances the completion clock other events depend on."
  [file]
  (when-not (fs/existsSync file) (println "REFUSED: update stream missing" file) (js/process.exit 2))
  (->> (str/split-lines (fs/readFileSync file "utf8"))
       (keep (fn [l]
               (when (seq l)
                 (let [[sim dep ty & ps] (str/split l #"\|")
                       type (parse-long ty)]
                   {:sim (parse-long sim) :dep (parse-long dep) :type type
                    :op (get {1 :ins1 2 :ins2 3 :ins3 4 :ins4 5 :ins5 6 :ins6 7 :ins7 8 :ins8} type)
                    :params (case type
                              1 {:person (nth ps 0) :first (nth ps 1) :last (nth ps 2) :gender (nth ps 3)
                                 :birthday (parse-long (nth ps 4)) :date (parse-long (nth ps 5)) :ip (nth ps 6) :browser (nth ps 7) :city (nth ps 8)}
                              2 {:person (nth ps 0) :post (nth ps 1) :date (parse-long (nth ps 2))}
                              3 {:person (nth ps 0) :comment (nth ps 1) :date (parse-long (nth ps 2))}
                              6 {:post (nth ps 0) :date (parse-long (nth ps 2)) :content (nth ps 6) :creator (nth ps 8) :forum (nth ps 9)}
                              7 (let [rp (nth ps 8) rc (nth ps 9)]
                                  {:comment (nth ps 0) :date (parse-long (nth ps 1)) :content (nth ps 4) :creator (nth ps 6)
                                   :parent (if (= rp "-1") rc rp)})
                              4 {:forum (nth ps 0) :title (nth ps 1) :date (parse-long (nth ps 2)) :moderator (nth ps 3)}
                              5 {:person (nth ps 0) :forum (nth ps 1) :date (parse-long (nth ps 2))}
                              8 {:p1 (nth ps 0) :p2 (nth ps 1) :date (parse-long (nth ps 2))}
                              nil)}))))
       vec))

(defn- percentile [xs q]
  (if (empty? xs) nil
      (let [s (vec (sort xs))]
        (nth s (min (dec (count s)) (js/Math.floor (* q (count s))))))))

(defn- stats [xs]
  {:n (count xs)
   :p50 (percentile xs 0.5) :p95 (percentile xs 0.95) :p99 (percentile xs 0.99)
   :max (when (seq xs) (reduce max xs))})

(defn- fetch-edn [origin path body]
  (-> (js/fetch (str origin path)
                (if body
                  #js {:method "POST"
                       :headers #js {"content-type" "application/edn"}
                       :body (pr-str body)}
                  #js {:method "GET"}))
      (.then (fn [res]
               (-> (.text res)
                   (.then (fn [txt] {:status (.-status res) :body txt})))))))

(defn- run-rate!
  "One scheduled run at `rate` ops/s for `seconds`. Resolves to the run's
   record. Open loop: dispatch times come from the schedule, not from
   completions; `inflight` bounds concurrency like driver threads would."
  [{:keys [origin rate seconds inflight ops impl stream tcr]}]
  (js/Promise.
   (fn [resolve _]
     (let [reads-total (long (* rate seconds))
           interval (/ 1000.0 rate)
           t0 (+ (now) 50)
           ;; the interleave (S22, ayatori iteration 32): stream events are
           ;; scheduled at t0 + (sim - sim0) * tcr wall ms, LDBC's time
           ;; compression; only those that fall inside the run are taken.
           ;; An event may START when every event scheduled before its
           ;; dependency time has COMPLETED (the driver's GCT rule), so a
           ;; dependency wait is lateness against its schedule, as the
           ;; certified driver counts it.
           sim0 (when (seq stream) (:sim (first stream)))
           events (when stream
                    (vec (take-while #(< (:wall %) (* 1000.0 seconds))
                                     (map #(assoc % :wall (* (- (:sim %) sim0) (or tcr 1.0))) stream))))
           updates-total (count events)
           total (+ reads-total updates-total)
           next-u (atom 0)
           in-flight-sims (atom (sorted-set))
           last-done-sim (atom (or sim0 0))
           completed-up-to (fn [] (if (seq @in-flight-sims) (dec (first @in-flight-sims)) @last-done-sim))
           records (atom [])
           in-flight (atom 0)
           next-k (atom 0)
           done (atom 0)
           finish! (fn []
                     (let [rs (remove :skipped @records)   ; events not sent are not operations
                           skipped (count (filter :skipped @records))
                           t-end (reduce max t0 (map :end rs))
                           delays (map :delay rs)
                           ok (filter #(= 200 (:status %)) rs)
                           failed (remove #(= 200 (:status %)) rs)
                           on-time (count (filter #(< % 1000) delays))
                           by-op (group-by :op rs)]
                       (resolve
                        {:rate rate :seconds seconds :inflight inflight
                         :scheduled total :reads-scheduled reads-total :updates-scheduled updates-total
                         :tcr tcr :completed (count rs)
                         :reads-completed (count (remove :update rs)) :updates-completed (count (filter :update rs))
                         :updates-skipped skipped
                         :failed (count failed)
                         :failed-sample (vec (take 3 (map #(select-keys % [:op :status :body]) failed)))
                         :on-time on-time
                         :on-time-pct (* 100.0 (/ on-time (max 1 (count rs))))
                         :throughput (/ (count ok) (/ (- t-end t0) 1000.0))
                         :start-delay-ms (stats (vec delays))
                         :empty-answers (count (filter #(zero? (or (:n %) 0)) ok))
                         :rows-mean (if (seq ok) (/ (reduce + (map :n ok)) (double (count ok))) 0)
                         :updates-applied (count (filter :update rs))
                         :updates-sample (into {} (for [[op rs] by-op :when (some :update rs)]
                                                   [op (mapv :update (take-last 20 (filter :update rs)))]))
                         :latency-ms (into {} (for [[op rs] by-op]
                                                [op (stats (mapv :latency rs))]))
                         :server-ms (into {} (for [[op rs] by-op]
                                               [op (stats (mapv #(or (:server-ms %) 0) rs))]))})))
           launch! (fn launch! [op p update? sched sim finish-one]
                     (let [start (now)]
                                   (-> (if update?
                                         (fetch-edn origin "/ldbc/update" (assoc p :op op))
                                         (fetch-edn origin "/ldbc/ic" (assoc p :op op :impl (or impl :datalog))))
                                       (.then (fn [{:keys [status body]}]
                                                (let [end (now)
                                                      ;; a 200 is an answer only if it has the answer's shape;
                                                      ;; `not edn` reads as a symbol and would otherwise count
                                                      ;; as an empty answer (control C, 2026-09-11)
                                                      parsed (when (= status 200)
                                                               (let [v (try (edn/read-string body) (catch :default _ nil))]
                                                                 (cond (and (map? v) (vector? (:rows v)) (integer? (:n v))) v
                                                                       (and (map? v) (true? (:ok v)) (integer? (:datoms v))) (assoc v :n (:datoms v))
                                                                       :else nil)))]
                                                  (swap! records conj
                                                         {:op op :scheduled sched :start start :end end
                                                          :delay (- start sched) :latency (- end start)
                                                          :update (when update? (assoc p :creator (:creator parsed) :p2-known (:p2-known parsed) :forum-known (:forum-known parsed)))
                                                          :status (if (and (= status 200) (nil? parsed)) 590 status)
                                                          :body (when (or (not= status 200) (nil? parsed)) (subs body 0 (min 120 (count body))))
                                                          :n (:n parsed) :server-ms (:server-ms parsed)}))))
                                       (.catch (fn [e]
                                                 (swap! records conj
                                                        {:op op :scheduled sched :start start :end (now)
                                                         :delay (- start sched) :latency (- (now) start)
                                                         :status 599 :body (str e)})))
                                       (.finally (fn []
                                                   (when sim
                                                     (swap! in-flight-sims disj sim)
                                                     (swap! last-done-sim max sim))
                                                   (swap! in-flight dec)
                                                   (swap! done inc)
                                                   (finish-one))))))
           dispatch! (fn dispatch! []
                       ;; start every op whose scheduled time has come, while a slot is
                       ;; free: the next stream event when it is due AND its dependency is
                       ;; complete, else the next read when it is due
                       (loop []
                         (let [t (now)
                               k @next-k
                               u @next-u
                               ev (when (< u updates-total) (nth events u))
                               ev-due? (and ev (>= t (+ t0 (:wall ev))) (<= (:dep ev) (completed-up-to)))
                               k-due? (and (< k reads-total) (>= t (+ t0 (* k interval))))]
                           (when (< @in-flight inflight)
                             (cond
                               ev-due?
                               (do (swap! next-u inc)
                                   (if (nil? (:params ev))
                                     ;; a type this driver does not send: completes at once
                                     (do (swap! last-done-sim max (:sim ev))
                                         (swap! records conj {:op (or (:op ev) :ins-other) :update {:skipped true} :skipped true
                                                              :scheduled (+ t0 (:wall ev)) :start t :end t :delay (- t (+ t0 (:wall ev))) :latency 0 :status 200 :n 0})
                                         (swap! done inc)
                                         (when (= @done total) (finish!))
                                         (recur))
                                     (do (swap! in-flight inc)
                                         (swap! in-flight-sims conj (:sim ev))
                                         (launch! (:op ev) (:params ev) true (+ t0 (:wall ev)) (:sim ev)
                                                  (fn [] (if (= @done total) (finish!) (dispatch!))))
                                         (recur))))
                               k-due?
                               (let [sched (+ t0 (* k interval))
                                     {:keys [op params update?]} (nth ops (mod k (count ops)))
                                     p (nth params (mod (quot k (count ops)) (count params)))]
                                 (swap! next-k inc)
                                 (swap! in-flight inc)
                                 (launch! op p update? sched nil (fn [] (if (= @done total) (finish!) (dispatch!))))
                                 (recur))
                               :else nil)))))
           tick (fn tick []
                  (dispatch!)
                  (when (or (< @next-k reads-total) (< @next-u updates-total))
                    (js/setTimeout tick 2)))]
       (js/setTimeout tick 0)))))

(defn -main [& args]
  (let [args (vec args)
        origin (arg args "--origin" "http://127.0.0.1:8090")
        pdir (arg args "--params" (path/join (os/homedir) ".cache/ldbc-snb/sf1/substitution_parameters-sf1"))
        rates (mapv parse-long (str/split (arg args "--rates" "5,10,20,40,80,160") #","))
        seconds (parse-long (arg args "--seconds" "20"))
        inflight (parse-long (arg args "--inflight" "64"))
        mix (str/split (arg args "--mix" "ic02,ic07,ic08,ic09") #",")
        out (arg args "--out" nil)
        impl (keyword (arg args "--impl" "datalog"))
        max-swap-pct (parse-double (arg args "--max-swap-pct" "90"))
        mem (host-memory)
        param-file {"ic02" 2 "ic07" 7 "ic08" 8 "ic09" 9 "is1" 7 "is2" 7 "is3" 7 "is4" :message "is5" :message "is6" :message "is7" :message}
        updates (arg args "--updates" nil)
        person-updates (arg args "--person-updates" nil)
        tcr (some-> (arg args "--tcr" nil) parse-double)
        stream (when tcr
                 (vec (sort-by :sim (concat (read-stream updates) (when person-updates (read-stream person-updates))))))
        update-type {"ins1" 1 "ins2" 2 "ins3" 3 "ins4" 4 "ins5" 5 "ins6" 6 "ins7" 7 "ins8" 8}
        ops (mapv (fn [op] (if-let [ty (update-type op)]
                             {:op (keyword op) :update? true
                              :params (read-updates (if (= ty 1) (or person-updates updates) updates) ty 100000)}
                             {:op (keyword op) :params (read-params pdir (param-file op))}))
                  mix)]
    (-> (fetch-edn origin "/ldbc/meta" nil)
        (.then (fn [{:keys [status body]}]
                 (when-not (= 200 status)
                   (println "REFUSED: server not ready" status body) (js/process.exit 2))
                 (let [meta (edn/read-string body)
                       ;; A SUT that is paged out answers the benchmark's question
                       ;; about the host, not the engine. The SUT's own reading wins
                       ;; when it has one (cross-host); the driver's host is the
                       ;; fallback. Refuse before measuring, and say which number.
                       sut-mem (:host-memory meta)
                       judged (if (map? sut-mem) [:sut sut-mem] [:driver-host mem])
                       [who m] judged]
                   (when (and (:swap-used-pct m) (> (:swap-used-pct m) max-swap-pct))
                     (println "REFUSED:" (name who) "swap" (.toFixed (:swap-used-pct m) 1) "% used exceeds --max-swap-pct" max-swap-pct
                              "-- a served number here measures paging, not the engine (iteration 14)")
                     (js/process.exit 2))
                   ;; A resident JVM's RSS exceeds its used heap (metaspace, code,
                   ;; stacks sit on top). RSS below used heap means part of the
                   ;; heap is not in memory. The first rule here was "below half"
                   ;; (iteration 14 saw 0.02 GB against 0.9); iteration 26 saw a
                   ;; full-SF1 SUT at rss 8.5 GB against 10.9 GB used heap, 6 GB in
                   ;; the host's swap and 3.8M page-ins, answer IC02 at 111 ms
                   ;; against 3.4 on the subset -- and pass. 0.95 is the rule now.
                   (when (and (:rss-mb sut-mem) (:heap-used-mb sut-mem) (pos? (:heap-used-mb sut-mem))
                              (< (:rss-mb sut-mem) (* 0.95 (:heap-used-mb sut-mem))))
                     (println "REFUSED: SUT rss" (:rss-mb sut-mem) "MB is below its used heap" (:heap-used-mb sut-mem)
                              "MB -- part of the SUT's heap is not resident (iterations 14, 26)")
                     (js/process.exit 2))
                   (println "SUT" (pr-str (select-keys meta [:elements :quads :threads :subset-rule])))
                   (println "load" (pr-str (mapv #(.toFixed % 2) (os/loadavg)))
                            "swap-used%" (str (name who) "=" (some-> (:swap-used-pct m) (.toFixed 1)))
                            "sut-rss/heap-mb" (str (:rss-mb sut-mem) "/" (:heap-used-mb sut-mem)) "origin" origin
                            "impl" (name impl) "index-path" (pr-str (:index-path meta))
                            "mix" (pr-str mix) "inflight" inflight "seconds" seconds)
                   (println)
                   (println "  rate  sched  done  fail  on-time%  thru/s  delay-p95  empty  rows  ic02-p50  ic07-p50  ic08-p50  ic09-p50")
                   (letfn [(go [remaining acc]
                             (if (empty? remaining)
                               (js/Promise.resolve acc)
                               (-> (run-rate! {:origin origin :rate (first remaining) :seconds seconds
                                               :inflight inflight :ops ops :impl impl :stream stream :tcr tcr})
                                   (.then (fn [r]
                                            (let [l (:latency-ms r)
                                                  p50 (fn [op] (or (some-> (get-in l [op :p50]) (.toFixed 1)) "-"))
                                                  extra (apply str (for [op (map keyword mix) :when (not (#{:ic02 :ic07 :ic08 :ic09} op))]
                                                                     (str "  " (.padStart (str (name op) " " (p50 op)) 9))))]
                                              (println (str "  " (.padStart (str (:rate r)) 4)
                                                            "  " (.padStart (str (:scheduled r)) 5)
                                                            "  " (.padStart (str (:completed r)) 4)
                                                            "  " (.padStart (str (:failed r)) 4)
                                                            "  " (.padStart (.toFixed (:on-time-pct r) 2) 8)
                                                            "  " (.padStart (.toFixed (:throughput r) 1) 6)
                                                            "  " (.padStart (.toFixed (or (get-in r [:start-delay-ms :p95]) 0) 0) 9)
                                                            "  " (.padStart (str (:empty-answers r)) 5)
                                                            "  " (.padStart (.toFixed (:rows-mean r) 1) 4)
                                                            "  " (.padStart (p50 :ic02) 8)
                                                            "  " (.padStart (p50 :ic07) 8)
                                                            "  " (.padStart (p50 :ic08) 8)
                                                            "  " (.padStart (p50 :ic09) 8)
                                                            extra
                                                            (when tcr (str "  | stream " (:updates-completed r) " upd sent = "
                                                                           (.toFixed (/ (:updates-completed r) seconds) 0) "/s (" (:updates-skipped r) " skipped)")))))
                                            (let [pass (and (zero? (:failed r)) (>= (:on-time-pct r) 95.0))
                                                  acc (conj acc (assoc r :pass pass))]
                                              (if pass (go (rest remaining) acc) (js/Promise.resolve acc))))))))]
                     (-> (go rates [])
                         (.then (fn [runs]
                                  ;; read-after-write: the last inserts of every run must be
                                  ;; visible to the reads that cover them (INS8 -> IS3 lists the
                                  ;; new friend; INS2 -> IC07 on the post's creator lists the liker)
                                  (let [all-samples (remove :skipped (mapcat (fn [r] (mapcat (fn [[op us]] (map #(assoc % :op op) us)) (:updates-sample r))) runs))
                                        ;; an INS2 whose post this SUT does not hold (a subset
                                        ;; rung) has no creator to read IC07 for: the write landed
                                        ;; (the SUT said so) but no served read covers it. Counted
                                        ;; and printed as unverifiable, never as visible.
                                        unverifiable (filter (fn [u] (or (and (#{:ins2 :ins3} (:op u)) (nil? (:creator u)))
                                                                         (and (= :ins8 (:op u)) (false? (:p2-known u)))))
                                                             all-samples)
                                        ;; INS5 (membership) has no covering read among the served ops
                                        ;; (IC05 would list the forum): the write landed, nothing here
                                        ;; can show it. A third class, distinct from unverifiable.
                                        no-covering-read (filter #(= :ins5 (:op %)) all-samples)
                                        samples (remove (set (concat unverifiable no-covering-read)) all-samples)
                                        check (fn [{:keys [op] :as u}]
                                                (case op
                                                  :ins8 (-> (fetch-edn origin "/ldbc/ic" {:op :is3 :person (:p1 u)})
                                                            (.then (fn [{:keys [body]}]
                                                                     (let [rows (:rows (edn/read-string body))]
                                                                       {:op op :ok (boolean (some #(= (:p2 u) (first %)) rows)) :u u}))))
                                                  ;; IC07 is a top-20 window: a like whose date is older than every
                                                  ;; row of a full window is outside it BY DESIGN (later likes from the
                                                  ;; same stream pushed it out), not lost -- counted as :outside-window
                                                  (:ins2 :ins3) (-> (fetch-edn origin "/ldbc/ic" {:op :ic07 :person (:creator u)})
                                                                    (.then (fn [{:keys [body]}]
                                                                             (let [rows (:rows (edn/read-string body))
                                                                                   seen (boolean (some #(= (:person u) (first %)) rows))
                                                                                   pushed-out (and (not seen) (= 20 (count rows))
                                                                                                   (every? #(>= (nth % 2) (:date u)) rows))]
                                                                               {:op op :ok (or seen pushed-out) :outside-window pushed-out :u u}))))
                                                  ;; INS1 -> IS1 shows the profile; INS6 -> IS4 shows the post's
                                                  ;; content; INS7 -> IS7 on the parent lists the comment
                                                  :ins1 (-> (fetch-edn origin "/ldbc/ic" {:op :is1 :person (:person u)})
                                                            (.then (fn [{:keys [body]}]
                                                                     (let [rows (:rows (edn/read-string body))]
                                                                       {:op op :ok (boolean (some #(= (:first u) (first %)) rows)) :u u}))))
                                                  ;; INS6 -> IS4 shows the post's date; and when the SUT said the
                                                  ;; forum is held with a named moderator, IS6 on the post must name
                                                  ;; the forum -- this is how INS4 is verified (through a post that
                                                  ;; landed in the forum it created)
                                                  :ins6 (-> (fetch-edn origin "/ldbc/ic" {:op :is4 :message (:post u)})
                                                            (.then (fn [{:keys [body]}]
                                                                     (let [rows (:rows (edn/read-string body))
                                                                           ok4 (boolean (some #(= (:date u) (first %)) rows))]
                                                                       (if (true? (:forum-known u))
                                                                         (-> (fetch-edn origin "/ldbc/ic" {:op :is6 :message (:post u)})
                                                                             (.then (fn [{:keys [body]}]
                                                                                      (let [rows (:rows (edn/read-string body))]
                                                                                        {:op op :ok (and ok4 (boolean (some #(= (:forum u) (first %)) rows)))
                                                                                         :is6-checked true :u u}))))
                                                                         {:op op :ok ok4 :u u})))))
                                                  ;; INS4 itself: no post may have landed in the forum yet, so the
                                                  ;; covering read is the INS6 -> IS6 check above; here the forum's
                                                  ;; own datoms are read back through IS6 only when a post exists.
                                                  ;; Not a claim of visibility on its own: counted under :ins6.
                                                  :ins4 (js/Promise.resolve {:op op :ok true :skipped-check true :u u})
                                                  :ins7 (-> (fetch-edn origin "/ldbc/ic" {:op :is7 :message (:parent u)})
                                                            (.then (fn [{:keys [body]}]
                                                                     (let [rows (:rows (edn/read-string body))]
                                                                       {:op op :ok (boolean (some #(= (:comment u) (first %)) rows)) :u u}))))))]
                                    (-> (js/Promise.all (clj->js (mapv check samples)))
                                        (.then (fn [results]
                                                 (let [results (vec (remove :skipped-check results))
                                                       failed (remove :ok results)]
                                                   (when (or (seq results) (seq unverifiable))
                                                     (println "read-after-write:" (count results) "checked," (count failed) "not visible,"
                                                              (count (filter :outside-window results)) "outside a full top-20 window (later likes pushed them out),"
                                                              (count unverifiable) "unverifiable (INS2 on a post, or INS8 to a person, this SUT does not hold),"
                                                              (count (filter :is6-checked results)) "posts also read back through IS6 (verifies INS4),"
                                                              (count no-covering-read) "INS5 with no covering read"
                                                              (when (seq failed) (pr-str (take 3 failed)))))
                                                   (when (seq failed)
                                                     (println "REFUSED: an insert the SUT acknowledged is not visible to the read that covers it")
                                                     (js/process.exit 2))
                                                   {:runs runs :results results :failed failed :unverifiable unverifiable :no-covering-read no-covering-read})))))))
                         (.then (fn [{:keys [runs results failed unverifiable no-covering-read]}]
                                  (let [passing (filter :pass runs)
                                        best (last passing)
                                        receipt {:schema 1
                                                 :receipt/type :ldbc-snb-interactive-network
                                                 :date (.slice (.toISOString (js/Date.)) 0 10)
                                                 :sut (dissoc meta :warm-persons)
                                                 :read-after-write {:checked (count results) :not-visible (count failed)
                                                                    :outside-window (count (filter :outside-window results)) :unverifiable (count unverifiable)
                                                                    :is6-checked (count (filter :is6-checked results)) :no-covering-read (count no-covering-read)}
                                                 :driver {:implementation "bench/ldbc_snb_driver.cljk (nbb, open-loop scheduled)"
                                                          :origin origin :mix mix :inflight inflight :seconds seconds :impl impl
                                                          :rule "95% of operations start within 1 s of schedule; zero failed operations"
                                                          :params "official substitution_parameters-sf1 interactive_{2,7,8,9}_param.txt, cycled"
                                                          :load-avg (mapv #(.toFixed % 2) (os/loadavg))
                                                          :driver-host-memory mem :sut-host-memory sut-mem
                                                          :judged-by who :max-swap-pct max-swap-pct}
                                                 :runs runs
                                                 :throughput-ops-s (when best (:throughput best))
                                                 :highest-passing-rate (when best (:rate best))
                                                 :not-an-ldbc-score (str "a stated SF1 subset; served reads " (pr-str (vec mix)) " of 29 ops; inserts "
                                                                          (if tcr "all 8 types from the stream" "only those in --mix") "; no ACID suite, no auditor")}]
                                    (when (and (seq runs) (pos? (:failed (first runs))))
                                      (println "REFUSED: failed operations at the first rate; nothing measured")
                                      (println (pr-str (:failed-sample (first runs))))
                                      (js/process.exit 2))
                                    (println)
                                    (println "throughput" (if best (.toFixed (:throughput best) 1) "none")
                                             "ops/s at rate" (:highest-passing-rate receipt)
                                             "(highest rate with >= 95% on-time starts and 0 failures)")
                                    (when out
                                      (fs/writeFileSync out (pr-str receipt))
                                      (println "wrote" out))
                                    (js/process.exit 0)))))))))
        (.catch (fn [e] (println "REFUSED:" (str e)) (js/process.exit 2))))))

(apply -main *command-line-args*)
