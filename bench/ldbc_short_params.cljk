#!/usr/bin/env nbb
;; bench/ldbc_short_params.cljk — short-read parameters for the SF1 subset.
;;
;; LDBC's driver derives IS4/IS5/IS7 message ids from complex-read results;
;; this subset (the N most recent Posts + their reply trees) has its own
;; population, so the ids are taken from it directly: the N most recent
;; Posts by creationDate, then every (N / count)-th one -- deterministic,
;; spread across the window, and always a message the SUT holds. Writes
;; short_message_param.txt (header `messageId`) beside the official files.
;;
;;   nbb bench/ldbc_short_params.cljk <ldbc-dynamic-dir> <params-dir> [posts=35000] [count=99]
(ns ldbc-short-params
  (:require [clojure.string :as str]
            ["fs" :as fs]
            ["path" :as path]))

(let [[dir pdir posts n] *command-line-args*
      posts (parse-long (or posts "35000"))
      n (parse-long (or n "99"))
      lines (rest (str/split-lines (fs/readFileSync (path/join dir "post_0_0.csv") "utf8")))
      rows (->> lines
                (keep (fn [l] (when (seq l) (let [[id _ cd] (str/split l #"\|")] [id (parse-long cd)]))))
                (sort-by second >)
                (take posts)
                vec)
      step (max 1 (quot (count rows) n))
      picked (take n (map first (take-nth step rows)))
      out (path/join pdir "short_message_param.txt")]
  (when (< (count rows) posts)
    (println "REFUSED: only" (count rows) "posts, wanted" posts) (js/process.exit 2))
  (fs/writeFileSync out (str "messageId\n" (str/join "\n" picked) "\n"))
  (println "wrote" out (count picked) "message ids, every" step "th of the" (count rows) "most recent posts"))
